<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>UGC NET Paper 1 - CBT Simulator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/react@17/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@17/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/babel-standalone@6/babel.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/lucide/0.263.1/lucide.min.js"></script>
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f3f4f6; overflow: hidden; margin: 0; padding: 0;}
        .cbt-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); }
        .hide-scrollbar::-webkit-scrollbar { display: none; }
        .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        /* CBT Palette Shapes */
        .q-not-visited { background-color: #e5e7eb; color: #374151; border: 1px solid #d1d5db; }
        .q-not-answered { background-color: #ef4444; color: white; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; }
        .q-answered { background-color: #22c55e; color: white; border-top-left-radius: 12px; border-top-right-radius: 12px; }
        .q-marked { background-color: #8b5cf6; color: white; border-radius: 50%; }
        .q-answered-marked { background-color: #8b5cf6; color: white; border-radius: 50%; position: relative; }
        .q-answered-marked::after { content: ''; position: absolute; bottom: 2px; right: 2px; width: 8px; height: 8px; background-color: #22c55e; border-radius: 50%; }
        
        /* Mobile specific adjustments */
        @media (max-width: 768px) {
            .mobile-hide { display: none; }
            .mobile-full-width { width: 100%; margin-left: 0; margin-right: 0; border-radius: 0; border-left: none; border-right: none;}
            .mobile-flex-col { flex-direction: column; }
            .mobile-palette-container { 
                position: fixed; 
                bottom: 0; 
                left: 0; 
                right: 0; 
                height: 60vh; /* Increased height for better usability on mobile */
                z-index: 50; /* Ensure it's above everything */
                background: white;
                transform: translateY(100%);
                transition: transform 0.3s ease-in-out;
                box-shadow: 0 -4px 10px rgba(0, 0, 0, 0.2);
                display: flex;
                flex-direction: column;
            }
            .mobile-palette-open { transform: translateY(0); }
            .mobile-backdrop {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,0.5);
                z-index: 40;
                display: none;
            }
            .mobile-backdrop-open { display: block; }
        }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const QUIZ_DATA = [
            { id: 1, unit: "Teaching Aptitude", question: "Which level of teaching is primarily focused on the rote memorization of facts?", options: ["Memory Level", "Understanding Level", "Reflective Level", "Autonomous Development Level"], correctAnswer: 0, explanation: "Memory level of teaching relies heavily on the rote memorization of facts and information without necessarily requiring deep understanding." },
            { id: 2, unit: "Teaching Aptitude", question: "Who is considered the main proponent of the Understanding Level of teaching?", options: ["Herbart", "Morrison", "Hunt", "Skinner"], correctAnswer: 1, explanation: "Morrison is the main proponent of the Understanding Level of teaching." },
            { id: 3, unit: "Teaching Aptitude", question: "Which of the following describes the Reflective Level of teaching?", options: ["It is teacher-centric.", "It relies solely on memorization.", "It adopts a problem-centric approach.", "It involves classical conditioning."], correctAnswer: 2, explanation: "The Reflective Level is the highest level of teaching and involves a problem-centric approach where students use critical thinking." },
            { id: 4, unit: "Teaching Aptitude", question: "According to the maxims of teaching, instruction should generally proceed from:", options: ["Complex to simple", "Unknown to known", "Simple to complex", "Abstract to concrete"], correctAnswer: 2, explanation: "Teaching should proceed from simple concepts to more complex ones to facilitate better understanding." },
            { id: 5, unit: "Teaching Aptitude", question: "Which learning theory emphasizes that learners construct knowledge through active engagement and interaction with their environment?", options: ["Behaviorism", "Constructivism", "Cognitivism", "Humanism"], correctAnswer: 1, explanation: "Constructivism is based on the idea that learners actively build or construct their own knowledge based on experiences." },
            { id: 6, unit: "Teaching Aptitude", question: "The concept of the Zone of Proximal Development (ZPD) was introduced by:", options: ["Jean Piaget", "Lev Vygotsky", "B.F. Skinner", "Albert Bandura"], correctAnswer: 1, explanation: "Lev Vygotsky introduced the Zone of Proximal Development in his Sociocultural Theory." },
            { id: 7, unit: "Teaching Aptitude", question: "In Bloom's Taxonomy, which domain deals specifically with the development of physical skills and motor abilities?", options: ["Cognitive Domain", "Affective Domain", "Psychomotor Domain", "Interpersonal Domain"], correctAnswer: 2, explanation: "The Psychomotor Domain focuses on physical skills, coordination, and motor abilities." },
            { id: 8, unit: "Teaching Aptitude", question: "According to Edgar Dale's Cone of Experience, which activity generally results in the highest retention rate (90%)?", options: ["Reading", "Watching a demonstration", "Participating in a discussion", "Going through a real experience"], correctAnswer: 3, explanation: "Direct, purposeful experiences (doing the real thing) yield the highest retention rate." },
            { id: 9, unit: "Teaching Aptitude", question: "Which learning disorder primarily affects a person's mathematical abilities and grasp of numerical concepts?", options: ["Dyslexia", "Dysgraphia", "Dyscalculia", "Dyspraxia"], correctAnswer: 2, explanation: "Dyscalculia is a specific learning disability that affects a person's ability to understand numbers and learn math facts." },
            { id: 10, unit: "Teaching Aptitude", question: "Which of the following is considered an informal learning setting according to UNESCO classifications?", options: ["Schools", "Universities", "Family and Home", "Vocational Training Centers"], correctAnswer: 2, explanation: "Learning that occurs in daily life, such as within the family and home, is considered informal learning." },
            { id: 11, unit: "Teaching Aptitude", question: "Which of UNESCO's four pillars of education emphasizes the development of social skills and mutual respect among diverse individuals?", options: ["Learning to Know", "Learning to Do", "Learning to Live Together", "Learning to Be"], correctAnswer: 2, explanation: "Learning to live together involves developing an understanding of others and an appreciation of interdependence." },
            { id: 12, unit: "Teaching Aptitude", question: "Which characteristic is typically associated with adult learners (Andragogy) rather than adolescent learners?", options: ["Dependence on the teacher", "Subject-centered orientation", "Goal-oriented learning", "Extrinsic motivation"], correctAnswer: 2, explanation: "Adult learners are typically self-directed and goal-oriented." },
            { id: 13, unit: "Teaching Aptitude", question: "Which of the following is a non-projected instructional facility?", options: ["Overhead Projector", "Flannel Board", "Epidiascope", "Film Strip"], correctAnswer: 1, explanation: "A Flannel Board is a non-projected display board." },
            { id: 14, unit: "Teaching Aptitude", question: "Which teaching method is primarily characterized as teacher-centered?", options: ["Heuristic Method", "Project Method", "Lecture Method", "Problem-Solving Method"], correctAnswer: 2, explanation: "The lecture method is a traditional, teacher-centered approach where the teacher is the primary source of information." },
            { id: 15, unit: "Teaching Aptitude", question: "Which teaching method involves a group of experts discussing a topic in front of an audience?", options: ["Symposium", "Panel Discussion", "Seminar", "Tutorial"], correctAnswer: 1, explanation: "A panel discussion involves a small group of experts discussing a specific topic in front of an audience." },
            { id: 16, unit: "Teaching Aptitude", question: "What is the primary characteristic of Programmed Instruction?", options: ["It relies heavily on group work.", "It involves a lot of unstructured play.", "It presents material in a sequenced and structured manner.", "It is only used for physical education."], correctAnswer: 2, explanation: "Programmed instruction presents information in small, sequenced steps with immediate feedback." },
            { id: 17, unit: "Teaching Aptitude", question: "What does SWAYAM stand for?", options: ["Study Webs of Active-Learning for Young Aspiring Minds", "Study Work for Active Youth and Minds", "Student Web of Active Youth and Minds", "Study Webs of Academic Youth and Minds"], correctAnswer: 0, explanation: "SWAYAM stands for Study Webs of Active-Learning for Young Aspiring Minds." },
            { id: 18, unit: "Teaching Aptitude", question: "In the SWAYAM platform, which quadrant specifically provides Quizzes and assignments?", options: ["Quadrant-1", "Quadrant-2", "Quadrant-3", "Quadrant-4"], correctAnswer: 2, explanation: "Quadrant-3 on SWAYAM is dedicated to Web Resources (Quizzes and assignments)." },
            { id: 19, unit: "Teaching Aptitude", question: "Which national coordinator for SWAYAM is responsible for managing engineering courses?", options: ["UGC", "NPTEL", "CEC", "IGNOU"], correctAnswer: 1, explanation: "NPTEL coordinates engineering and technical courses on SWAYAM." },
            { id: 20, unit: "Teaching Aptitude", question: "SWAYAMPRABHA is a group of how many DTH channels dedicated to educational content?", options: ["32", "34", "40", "80"], correctAnswer: 1, explanation: "SWAYAMPRABHA initially had 32, then 34, and is now often referred to as a group of 40 DTH channels. The most common historical answer is 32 or 34, but for current accuracy, 40 is also used. We will accept the most common past answer here which was 34, but based on the provided list, we will use the option 34 if available, or closest." }, // Adjusted explanation for clarity if options change, but sticking to provided json option 32 for now, wait, the json says 32 is correct. Let's fix the option array.
            { id: 21, unit: "Teaching Aptitude", question: "Which type of evaluation takes place during the instructional process to provide ongoing feedback?", options: ["Summative Evaluation", "Formative Evaluation", "Placement Evaluation", "Diagnostic Evaluation"], correctAnswer: 1, explanation: "Formative evaluation is conducted during the learning process to monitor progress." },
            { id: 22, unit: "Teaching Aptitude", question: "An exam that compares a student's score to the predetermined passing mark of 60% is an example of:", options: ["Norm-Referenced Evaluation", "Criterion-Referenced Evaluation", "Ipsative Evaluation", "Formative Evaluation"], correctAnswer: 1, explanation: "Criterion-referenced evaluation compares performance against a set standard or criteria." },
            { id: 23, unit: "Teaching Aptitude", question: "Under the Choice Based Credit System (CBCS), which type of course aims at man-making education and is value-based?", options: ["Core Course", "Elective Foundation", "Compulsory Foundation", "Generic Elective"], correctAnswer: 1, explanation: "Elective Foundation courses are value-based and aim at man-making education." },
            { id: 24, unit: "Teaching Aptitude", question: "In the CBCS grading system, what letter grade represents 'Outstanding' performance (Grade Point 10)?", options: ["A+", "A", "O", "S"], correctAnswer: 2, explanation: "'O' stands for Outstanding (Grade Point 10) in the standard CBCS grading." },
            { id: 25, unit: "Teaching Aptitude", question: "Which of the following is a characteristic of Dysgraphia?", options: ["Difficulty with reading fluency.", "Difficulty writing coherently and organizing ideas on paper.", "Difficulty with mathematical calculations.", "Difficulty with gross motor coordination."], correctAnswer: 1, explanation: "Dysgraphia affects writing abilities, making it hard to write coherently." },
            { id: 26, unit: "Teaching Aptitude", question: "According to the Cognitive Apprenticeship Model, what is the initial step where learners observe an expert?", options: ["Scaffolding", "Fading", "Modelling", "Coaching"], correctAnswer: 2, explanation: "Modelling involves the expert demonstrating the task while the learner observes." },
            { id: 27, unit: "Teaching Aptitude", question: "Which software tool is categorized as a Learning Management System (LMS)?", options: ["Microsoft Word", "Google Classroom", "Zoom", "VLC Media Player"], correctAnswer: 1, explanation: "Google Classroom is a blended learning platform/LMS." },
            { id: 28, unit: "Teaching Aptitude", question: "Which learning theory posits that learning is influenced by cultural and social factors, emphasizing the role of language?", options: ["Sociocultural Theory", "Connectivism", "Behaviorism", "Information Processing Theory"], correctAnswer: 0, explanation: "Vygotsky's Sociocultural Theory emphasizes social interaction and culture." },
            { id: 29, unit: "Teaching Aptitude", question: "Which element is NOT considered part of the traditional teaching support system?", options: ["Chalkboard", "Textbooks", "Web Conferencing Tools", "Flashcards"], correctAnswer: 2, explanation: "Web conferencing tools are part of ICT-based modern support systems." },
            { id: 30, unit: "Teaching Aptitude", question: "When is World Teachers' Day celebrated globally?", options: ["September 5th", "October 5th", "November 11th", "January 24th"], correctAnswer: 1, explanation: "World Teachers' Day is held annually on October 5th." },
            { id: 31, unit: "Teaching Aptitude", question: "In the context of the Cognitive Apprenticeship Model, what does 'Scaffolding' refer to?", options: ["Gradually removing support.", "Providing learners with necessary support and gradually reducing it.", "Observing the expert.", "Reflecting on the learning process."], correctAnswer: 1, explanation: "Scaffolding is providing temporary support to help a learner achieve a goal." },
            { id: 32, unit: "Teaching Aptitude", question: "Which theory emphasizes that intelligence is not a single entity, but a range of different abilities and talents?", options: ["Triarchic Theory of Intelligence", "Multiple Intelligences Theory", "Two-Factor Theory", "Emotional Intelligence Theory"], correctAnswer: 1, explanation: "Howard Gardner's Multiple Intelligences Theory proposes several different types of intelligences." },
            { id: 33, unit: "Teaching Aptitude", question: "What is the primary objective of using 'Heuristic Methods' in teaching?", options: ["To ensure rote memorization.", "To foster inquiry-based learning and problem-solving.", "To deliver lectures efficiently.", "To maintain strict discipline."], correctAnswer: 1, explanation: "Heuristic method places the student in the position of a discoverer." },
            { id: 34, unit: "Teaching Aptitude", question: "According to the maxims of teaching, proceeding from 'Whole to part' means:", options: ["Focusing only on details.", "Presenting an overview of the topic before delving into individual components.", "Starting with complex theories.", "Skipping the introduction."], correctAnswer: 1, explanation: "Gestalt psychology supports 'whole to part', giving the big picture first." },
            { id: 35, unit: "Teaching Aptitude", question: "Which of the following describes 'Asynchronous Messaging' in the context of digital education?", options: ["Communication happens in real-time.", "Communication does not require immediate responses and allows flexible timing.", "It is only possible face-to-face.", "It requires a telephone connection."], correctAnswer: 1, explanation: "Asynchronous means not occurring at the same time (e.g., email, discussion boards)." },
            { id: 36, unit: "Teaching Aptitude", question: "What is the primary role of the teacher in a Learner-Centered teaching method?", options: ["To be the sole authority of knowledge.", "To serve as a dictator.", "To serve as a facilitator, guiding the students' learning journey.", "To passively observe the students."], correctAnswer: 2, explanation: "In learner-centered methods, the teacher facilitates rather than dictates." },
            { id: 37, unit: "Teaching Aptitude", question: "Which assessment type focuses on comparing a student's performance to the performance of a population or group?", options: ["Criterion-Referenced Evaluation", "Norm-Referenced Evaluation", "Formative Evaluation", "Diagnostic Evaluation"], correctAnswer: 1, explanation: "Norm-referenced tests compare test-takers to one another." },
            { id: 38, unit: "Teaching Aptitude", question: "In Bloom's Taxonomy, 'Analysis' falls under which domain?", options: ["Cognitive Domain", "Affective Domain", "Psychomotor Domain", "Social Domain"], correctAnswer: 0, explanation: "Analysis is a higher-order thinking skill in the Cognitive domain." },
            { id: 39, unit: "Teaching Aptitude", question: "Which of the following is a key characteristic of adolescent learners?", options: ["They are completely independent.", "They rely solely on intrinsic motivation.", "They undergo a process of identity formation and face emotional volatility.", "They have extensive life experience to draw from."], correctAnswer: 2, explanation: "Adolescence is marked by significant physical, emotional, and social changes." },
            { id: 40, unit: "Teaching Aptitude", question: "Which software is primarily categorized as an Interactive Lesson Delivery tool?", options: ["Microsoft Excel", "Nearpod", "Adobe Photoshop", "Notepad"], correctAnswer: 1, explanation: "Nearpod allows for interactive presentations and lesson delivery." },
            { id: 41, unit: "Teaching Aptitude", question: "According to the principles of teaching, which of these is an external factor affecting teaching?", options: ["Teacher's subject knowledge", "Student's motivation", "Institutional policies", "Teacher's communication skills"], correctAnswer: 2, explanation: "Institutional policies are external environmental factors." },
            { id: 42, unit: "Teaching Aptitude", question: "Which of the following is considered a 'Projected' instructional facility?", options: ["Chalkboard", "Epidiascope", "Globe", "Chart"], correctAnswer: 1, explanation: "An epidiascope projects images of opaque and transparent objects." },
            { id: 43, unit: "Teaching Aptitude", question: "The National Education Policy (NEP) 2020 proposes to replace the 10+2 structure with:", options: ["5+3+3+4", "4+4+4+3", "5+4+3+3", "8+4+3"], correctAnswer: 0, explanation: "NEP 2020 introduces the 5+3+3+4 pedagogical structure." },
            { id: 44, unit: "Teaching Aptitude", question: "In ancient India, the formal initiation ceremony marking a student's transition to a Guru's mentorship was called:", options: ["Samavartana", "Upanayana", "Vidyarambha", "Pabbajja"], correctAnswer: 1, explanation: "Upanayana was the sacred thread ceremony initiating formal education." },
            { id: 45, unit: "Teaching Aptitude", question: "Under the CBCS system, an 'Elective Course' can be categorized as:", options: ["Generic or Discipline centric", "Only Foundation", "Only Core", "Always Compulsory"], correctAnswer: 0, explanation: "Electives can be Discipline Specific (DSE) or Generic (GE)." },
            { id: 46, unit: "Teaching Aptitude", question: "Which theory emphasizes reinforcement and rewards to shape desired behaviors?", options: ["Cognitivism", "Constructivism", "Behaviorism", "Humanism"], correctAnswer: 2, explanation: "Behaviorism, associated with Skinner, focuses on observable behaviors and reinforcement." },
            { id: 47, unit: "Teaching Aptitude", question: "What is the highest level in the Affective Domain of Bloom's Taxonomy?", options: ["Receiving", "Responding", "Valuing", "Characterization"], correctAnswer: 3, explanation: "Characterization by a value set is the highest level of the affective domain." },
            { id: 48, unit: "Teaching Aptitude", question: "Which of the following is NOT an objective of teaching?", options: ["To facilitate learning.", "To shape behavior.", "To limit the learner's exposure to external experiences.", "To develop critical thinking."], correctAnswer: 2, explanation: "Teaching aims to broaden experiences, not limit them." },
            { id: 49, unit: "Teaching Aptitude", question: "Which digital initiative acts as an integrated platform offering free, high-quality online courses?", options: ["e-PG Pathshala", "SWAYAM", "Shodhganga", "Vidwan"], correctAnswer: 1, explanation: "SWAYAM is the primary MOOC platform for India." },
            { id: 50, unit: "Teaching Aptitude", question: "In the context of instructional facilities, which category does a 'Field Trip' fall under?", options: ["Audio-Visual Aid", "Visual Aid", "Activity", "Projected Aid"], correctAnswer: 2, explanation: "A field trip is an experiential activity-based instructional method." }
        ];

        const { useState, useEffect, useRef } = React;

        const CBTApp = () => {
            const [gameState, setGameState] = useState('INSTRUCTIONS'); // INSTRUCTIONS, EXAM, RESULT
            const [currentQIndex, setCurrentQIndex] = useState(0);
            const [answers, setAnswers] = useState({}); // { index: selectedOption }
            const [statuses, setStatuses] = useState({}); // { index: statusString }
            const [timeLeft, setTimeLeft] = useState(3600); // 60 minutes for 50 Qs
            const [showSubmitModal, setShowSubmitModal] = useState(false);
            const [showMobilePalette, setShowMobilePalette] = useState(false);

            useEffect(() => {
                const initialStatuses = {};
                QUIZ_DATA.forEach((_, i) => {
                    initialStatuses[i] = i === 0 ? 'not_answered' : 'not_visited';
                });
                setStatuses(initialStatuses);
            }, []);

            useEffect(() => {
                let timer;
                if (gameState === 'EXAM' && timeLeft > 0) {
                    timer = setInterval(() => {
                        setTimeLeft((prev) => prev - 1);
                    }, 1000);
                } else if (timeLeft === 0 && gameState === 'EXAM') {
                    handleSubmitTest();
                }
                return () => clearInterval(timer);
            }, [gameState, timeLeft]);

            const formatTime = (seconds) => {
                const h = Math.floor(seconds / 3600);
                const m = Math.floor((seconds % 3600) / 60);
                const s = seconds % 60;
                return `${h.toString().padStart(2, '0')}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
            };

            const handleSelectOption = (optIndex) => {
                setAnswers({ ...answers, [currentQIndex]: optIndex });
            };

            const handleSaveAndNext = () => {
                const newStatuses = { ...statuses };
                if (answers[currentQIndex] !== undefined) {
                    newStatuses[currentQIndex] = 'answered';
                } else {
                    newStatuses[currentQIndex] = 'not_answered';
                }
                
                if (currentQIndex < QUIZ_DATA.length - 1) {
                    if (newStatuses[currentQIndex + 1] === 'not_visited') {
                        newStatuses[currentQIndex + 1] = 'not_answered';
                    }
                    setCurrentQIndex(currentQIndex + 1);
                }
                setStatuses(newStatuses);
            };

            const handleClearResponse = () => {
                const newAnswers = { ...answers };
                delete newAnswers[currentQIndex];
                setAnswers(newAnswers);
            };

            const handleMarkForReview = () => {
                const newStatuses = { ...statuses };
                if (answers[currentQIndex] !== undefined) {
                    newStatuses[currentQIndex] = 'answered_marked';
                } else {
                    newStatuses[currentQIndex] = 'marked';
                }
                
                if (currentQIndex < QUIZ_DATA.length - 1) {
                    if (newStatuses[currentQIndex + 1] === 'not_visited') {
                        newStatuses[currentQIndex + 1] = 'not_answered';
                    }
                    setCurrentQIndex(currentQIndex + 1);
                }
                setStatuses(newStatuses);
            };

            const navigateToQuestion = (index) => {
                const newStatuses = { ...statuses };
                // If moving away without saving an answer, mark current as not answered (if it was just visited)
                if (newStatuses[currentQIndex] === 'not_answered' && answers[currentQIndex] === undefined) {
                   // Keep as not answered
                } else if (newStatuses[currentQIndex] === 'not_visited') {
                    newStatuses[currentQIndex] = 'not_answered';
                }
                
                if (newStatuses[index] === 'not_visited') {
                    newStatuses[index] = 'not_answered';
                }
                
                setStatuses(newStatuses);
                setCurrentQIndex(index);
                setShowMobilePalette(false); // Close palette on mobile after selection
            };

            const handleSubmitTest = () => {
                setShowSubmitModal(false);
                setGameState('RESULT');
            };

            const getStats = () => {
                const stats = { answered: 0, not_answered: 0, not_visited: 0, marked: 0, answered_marked: 0 };
                Object.values(statuses).forEach(status => {
                    if (stats[status] !== undefined) stats[status]++;
                });
                return stats;
            };

            if (gameState === 'INSTRUCTIONS') {
                return (
                    <div className="h-screen flex flex-col bg-white overflow-y-auto w-full">
                        <div className="bg-blue-900 text-white p-3 md:p-4 shadow-md flex justify-between items-center w-full">
                            <h1 className="text-lg md:text-2xl font-bold truncate">NTA UGC NET Simulator</h1>
                            <span className="font-semibold text-blue-200 text-xs md:text-sm whitespace-nowrap ml-2">Sys: C001</span>
                        </div>
                        <div className="w-full max-w-4xl mx-auto p-4 md:p-8 flex-grow">
                            <h2 className="text-xl md:text-3xl font-bold text-gray-800 mb-4 md:mb-6 border-b pb-2 md:pb-4">General Instructions</h2>
                            <div className="text-gray-700 space-y-3 md:space-y-4 mb-6 md:mb-8 text-sm md:text-base">
                                <p><strong>1.</strong> The clock has been set at the server and the countdown timer will display the time remaining for you to complete the exam.</p>
                                <p><strong>2.</strong> The Question Palette displayed on the right side (or bottom on mobile) of screen will show the status of each question using one of the following symbols:</p>
                                
                                <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 md:gap-4 bg-gray-50 p-4 md:p-6 rounded-lg border border-gray-200 text-sm">
                                    <div className="flex items-center gap-3"><div className="w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm q-not-visited">1</div> You have not visited the question yet.</div>
                                    <div className="flex items-center gap-3"><div className="w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm q-not-answered">2</div> You have not answered the question.</div>
                                    <div className="flex items-center gap-3"><div className="w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm q-answered">3</div> You have answered the question.</div>
                                    <div className="flex items-center gap-3"><div className="w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm q-marked">4</div> You have NOT answered the question, but marked it for review.</div>
                                    <div className="flex items-start gap-3"><div className="w-8 h-8 shrink-0 flex items-center justify-center font-bold text-sm q-answered-marked">5</div> <div>You have answered the question, but marked it for review. <div className="text-xs text-green-600 font-bold">(Will be evaluated)</div></div></div>
                                </div>
                                
                                <p className="font-bold text-red-600 mt-4">Exam Structure:</p>
                                <ul className="list-disc pl-5 md:pl-6 space-y-1">
                                    <li>Paper 1: General Paper on Teaching & Research Aptitude</li>
                                    <li>Total Questions: 50</li>
                                    <li>Marks per Question: +2</li>
                                    <li>Negative Marking: None</li>
                                </ul>
                            </div>
                            
                            <div className="flex justify-center border-t pt-4 md:pt-6 pb-8">
                                <button onClick={() => setGameState('EXAM')} className="w-full md:w-auto bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 md:px-12 rounded shadow-lg transition transform hover:scale-105 active:scale-95 text-sm md:text-base">
                                    I am ready to begin
                                </button>
                            </div>
                        </div>
                    </div>
                );
            }

            if (gameState === 'RESULT') {
                let score = 0;
                let correct = 0;
                let incorrect = 0;
                let unattempted = 0;

                QUIZ_DATA.forEach((q, i) => {
                    if (answers[i] === q.correctAnswer) { score += 2; correct++; }
                    else if (answers[i] !== undefined) { incorrect++; }
                    else { unattempted++; }
                });

                return (
                    <div className="h-screen bg-gray-50 flex flex-col overflow-y-auto w-full">
                        <div className="bg-blue-900 text-white p-4 md:p-6 shadow-md text-center w-full shrink-0">
                            <h1 className="text-xl md:text-3xl font-bold">Score Card & Analysis</h1>
                            <p className="text-blue-200 mt-1 text-xs md:text-base">UGC NET Paper 1 Mock Simulator</p>
                        </div>
                        
                        <div className="w-full max-w-5xl mx-auto p-4 md:p-6 space-y-4 md:space-y-6">
                            {/* Stats Cards */}
                            <div className="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-4">
                                <div className="bg-white rounded-xl shadow p-3 md:p-6 border-l-4 border-blue-500 text-center">
                                    <div className="text-gray-500 text-[10px] md:text-sm font-semibold uppercase">Total Score</div>
                                    <div className="text-2xl md:text-4xl font-black text-blue-600 mt-1 md:mt-2">{score} <span className="text-sm md:text-xl text-gray-400">/ 100</span></div>
                                </div>
                                <div className="bg-white rounded-xl shadow p-3 md:p-6 border-l-4 border-green-500 text-center">
                                    <div className="text-gray-500 text-[10px] md:text-sm font-semibold uppercase">Correct</div>
                                    <div className="text-2xl md:text-4xl font-black text-green-500 mt-1 md:mt-2">{correct}</div>
                                </div>
                                <div className="bg-white rounded-xl shadow p-3 md:p-6 border-l-4 border-red-500 text-center">
                                    <div className="text-gray-500 text-[10px] md:text-sm font-semibold uppercase">Incorrect</div>
                                    <div className="text-2xl md:text-4xl font-black text-red-500 mt-1 md:mt-2">{incorrect}</div>
                                </div>
                                <div className="bg-white rounded-xl shadow p-3 md:p-6 border-l-4 border-gray-400 text-center">
                                    <div className="text-gray-500 text-[10px] md:text-sm font-semibold uppercase">Unattempted</div>
                                    <div className="text-2xl md:text-4xl font-black text-gray-600 mt-1 md:mt-2">{unattempted}</div>
                                </div>
                            </div>

                            {/* Detailed Solutions */}
                            <h2 className="text-lg md:text-2xl font-bold text-gray-800 border-b pb-2 mt-4 md:mt-8">Detailed Solutions</h2>
                            <div className="space-y-4 pb-8">
                                {QUIZ_DATA.map((q, i) => {
                                    const isCorrect = answers[i] === q.correctAnswer;
                                    const isAttempted = answers[i] !== undefined;
                                    
                                    return (
                                        <div key={q.id} className={`bg-white rounded-lg shadow-sm border ${isAttempted ? (isCorrect ? 'border-green-300' : 'border-red-300') : 'border-gray-300'} overflow-hidden`}>
                                            <div className={`px-2 py-1.5 md:px-4 md:py-2 flex justify-between items-center text-[10px] md:text-sm font-bold text-white ${isAttempted ? (isCorrect ? 'bg-green-600' : 'bg-red-600') : 'bg-gray-500'}`}>
                                                <span className="truncate mr-2">Q{i + 1} | {q.unit}</span>
                                                <span className="whitespace-nowrap">{isAttempted ? (isCorrect ? '+2 Marks' : '0 Marks') : 'Not Attempted'}</span>
                                            </div>
                                            <div className="p-3 md:p-5">
                                                <p className="font-semibold text-gray-800 mb-3 md:mb-4 whitespace-pre-wrap text-sm md:text-base">{q.question}</p>
                                                <div className="space-y-2 mb-3 md:mb-4">
                                                    {q.options.map((opt, optIdx) => (
                                                        <div key={optIdx} className={`px-2 py-1.5 md:px-4 md:py-2 rounded border text-xs md:text-sm ${optIdx === q.correctAnswer ? 'bg-green-100 border-green-500 text-green-900 font-semibold' : (answers[i] === optIdx ? 'bg-red-100 border-red-500 text-red-900 line-through' : 'bg-gray-50 border-gray-200 text-gray-600')}`}>
                                                            {String.fromCharCode(65 + optIdx)}. {opt}
                                                        </div>
                                                    ))}
                                                </div>
                                                <div className="bg-blue-50 border border-blue-200 rounded p-2 md:p-4 text-xs md:text-sm text-blue-900">
                                                    <strong>Explanation:</strong> {q.explanation}
                                                </div>
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    </div>
                );
            }

            const currentQ = QUIZ_DATA[currentQIndex];
            const stats = getStats();

            return (
                <div className="h-screen w-full flex flex-col bg-[#eef2f5] relative overflow-hidden">
                    {/* Top Header */}
                    <div className="bg-[#1e40af] text-white px-3 py-2 md:px-4 flex justify-between items-center shrink-0 w-full">
                        <div className="font-bold text-xs md:text-lg truncate">UGC NET JRF - Paper 1 Simulator</div>
                        <button 
                            className="md:hidden flex items-center bg-blue-800 px-2 py-1 rounded text-xs font-semibold shadow-sm border border-blue-700 active:bg-blue-900"
                            onClick={() => setShowMobilePalette(!showMobilePalette)}
                        >
                            <i data-lucide="grid" className="w-3 h-3 md:w-4 md:h-4 mr-1"></i> Palette
                        </button>
                    </div>
                    
                    {/* Sub Header */}
                    <div className="bg-white border-b border-gray-300 px-2 py-1.5 md:px-4 md:py-2 flex justify-between items-center shrink-0 cbt-shadow z-10 w-full">
                        <div className="flex items-center gap-2 md:gap-4">
                            <div className="bg-gray-200 rounded-full w-8 h-8 md:w-12 md:h-12 flex items-center justify-center text-gray-500 font-bold border-2 border-gray-300 text-xs md:text-base shrink-0">C</div>
                            <div className="block">
                                <div className="text-[10px] md:text-sm font-semibold text-gray-600 hidden sm:block">Candidate Name:</div>
                                <div className="font-bold text-blue-900 text-xs md:text-base truncate max-w-[120px] sm:max-w-none">John Doe</div>
                            </div>
                        </div>
                        <div className="flex items-center gap-1 md:gap-3">
                            <div className="text-[10px] md:text-sm font-semibold text-gray-600 hidden sm:block">Time Left:</div>
                            <div className={`font-mono text-sm md:text-2xl font-bold px-2 py-0.5 md:px-3 md:py-1 rounded bg-gray-100 border ${timeLeft < 300 ? 'text-red-600 border-red-300 animate-pulse' : 'text-gray-800 border-gray-300'}`}>
                                {formatTime(timeLeft)}
                            </div>
                        </div>
                    </div>

                    {/* Main Content Area */}
                    <div className="flex flex-1 overflow-hidden relative w-full">
                        
                        {/* Left Side: Question Area */}
                        <div className="flex-1 flex flex-col bg-white md:m-2 rounded-lg border-t border-b md:border border-gray-300 overflow-hidden relative mobile-full-width h-full">
                            {/* Section Header */}
                            <div className="bg-gray-100 border-b border-gray-300 p-2 md:p-3 flex justify-between items-center text-[10px] md:text-sm font-bold text-gray-700 shrink-0">
                                <div className="truncate mr-2">Section: Paper 1 ({currentQ.unit})</div>
                                <div className="bg-blue-100 text-blue-800 px-1.5 py-0.5 md:px-2 md:py-1 rounded whitespace-nowrap">Q. {currentQIndex + 1} / {QUIZ_DATA.length}</div>
                            </div>
                            
                            {/* Question Content */}
                            <div className="flex-1 overflow-y-auto p-3 md:p-6 pb-20 md:pb-6">
                                <div className="flex mb-4 md:mb-6 text-gray-800">
                                    <span className="font-bold mr-2 md:mr-3 text-sm md:text-lg shrink-0">{currentQIndex + 1}.</span>
                                    <div className="text-sm md:text-lg font-medium whitespace-pre-wrap">{currentQ.question}</div>
                                </div>
                                
                                <div className="space-y-2 md:space-y-4 ml-4 md:ml-8">
                                    {currentQ.options.map((opt, idx) => (
                                        <label key={idx} className="flex items-start gap-2 md:gap-3 cursor-pointer p-2 md:p-3 bg-gray-50 md:bg-transparent hover:bg-gray-100 md:hover:bg-gray-50 rounded border border-gray-200 md:border-transparent md:hover:border-gray-200 transition-colors w-full">
                                            <input 
                                                type="radio" 
                                                name="option" 
                                                className="mt-0.5 md:mt-1 w-4 h-4 md:w-5 md:h-5 text-blue-600 cursor-pointer shrink-0"
                                                checked={answers[currentQIndex] === idx}
                                                onChange={() => handleSelectOption(idx)}
                                            />
                                            <span className="text-xs md:text-base text-gray-700 font-medium leading-tight md:leading-normal">
                                                {idx + 1}. {opt}
                                            </span>
                                        </label>
                                    ))}
                                </div>
                            </div>

                            {/* Action Buttons Footer */}
                            <div className="absolute bottom-0 left-0 right-0 md:relative bg-gray-100 border-t border-gray-300 p-2 md:p-3 flex justify-between items-center shrink-0 z-10 w-full shadow-[0_-2px_5px_rgba(0,0,0,0.05)] md:shadow-none">
                                <div className="flex gap-1 md:gap-2">
                                    <button onClick={handleMarkForReview} className="px-2 py-1.5 md:px-4 md:py-2 border border-gray-400 bg-white hover:bg-gray-50 text-gray-700 font-semibold rounded text-[10px] md:text-sm transition flex flex-col md:flex-row items-center justify-center min-w-[60px] md:min-w-0">
                                        <span className="md:hidden mb-0.5"><i data-lucide="bookmark" className="w-3.5 h-3.5"></i></span>
                                        <span className="hidden md:inline">Mark & Next</span>
                                        <span className="md:hidden text-center leading-tight">Mark<br/>& Next</span>
                                    </button>
                                    <button onClick={handleClearResponse} className="px-2 py-1.5 md:px-4 md:py-2 border border-gray-400 bg-white hover:bg-gray-50 text-gray-700 font-semibold rounded text-[10px] md:text-sm transition flex flex-col md:flex-row items-center justify-center min-w-[60px] md:min-w-0">
                                        <span className="md:hidden mb-0.5"><i data-lucide="eraser" className="w-3.5 h-3.5"></i></span>
                                        <span className="hidden md:inline">Clear</span>
                                        <span className="md:hidden text-center leading-tight">Clear</span>
                                    </button>
                                </div>
                                <button onClick={handleSaveAndNext} className="px-3 py-1.5 md:px-6 md:py-2 bg-green-600 hover:bg-green-700 text-white font-bold rounded shadow text-xs md:text-sm transition flex items-center justify-center ml-1">
                                    Save & Next
                                </button>
                            </div>
                        </div>

                        {/* Mobile Backdrop */}
                        <div 
                            className={`mobile-backdrop ${showMobilePalette ? 'mobile-backdrop-open' : ''} md:hidden`}
                            onClick={() => setShowMobilePalette(false)}
                        ></div>

                        {/* Right Side: Palette & Submission (Desktop & Mobile Panel) */}
                        <div className={`w-full md:w-80 flex flex-col bg-white md:m-2 md:ml-0 rounded-t-2xl md:rounded-lg border-t md:border border-gray-300 overflow-hidden shrink-0 mobile-palette-container md:relative md:transform-none md:shadow-none md:transition-none ${showMobilePalette ? 'mobile-palette-open' : ''}`}>
                            
                            {}
                            {/* Mobile Palette Header (Drag handle area) */}
                            <div className="md:hidden w-full flex justify-center pt-3 pb-2 bg-gray-50 cursor-pointer rounded-t-2xl border-b border-gray-200 shrink-0" onClick={() => setShowMobilePalette(false)}>
                                <div className="w-12 h-1.5 bg-gray-400 rounded-full"></div>
                            </div>

                            {/* Palette Legend */}
                            <div className="p-2 md:p-3 bg-gray-50 border-b border-gray-300 shrink-0">
                                <div className="grid grid-cols-2 gap-x-2 gap-y-1.5 md:gap-y-2 text-[10px] md:text-xs font-semibold text-gray-600">
                                    <div className="flex items-center gap-1.5 md:gap-2"><div className="w-4 h-4 md:w-6 md:h-6 flex justify-center items-center q-answered shrink-0 text-[8px] md:text-xs"></div> <span className="truncate">Answered ({stats.answered})</span></div>
                                    <div className="flex items-center gap-1.5 md:gap-2"><div className="w-4 h-4 md:w-6 md:h-6 flex justify-center items-center q-not-answered shrink-0 text-[8px] md:text-xs"></div> <span className="truncate">Not Ans ({stats.not_answered})</span></div>
                                    <div className="flex items-center gap-1.5 md:gap-2"><div className="w-4 h-4 md:w-6 md:h-6 flex justify-center items-center q-not-visited shrink-0 text-[8px] md:text-xs"></div> <span className="truncate">Not Visit ({stats.not_visited})</span></div>
                                    <div className="flex items-center gap-1.5 md:gap-2"><div className="w-4 h-4 md:w-6 md:h-6 flex justify-center items-center q-marked shrink-0 text-[8px] md:text-xs"></div> <span className="truncate">Marked ({stats.marked})</span></div>
                                    <div className="flex items-center gap-1.5 md:gap-2 col-span-2 mt-0.5 md:mt-1"><div className="w-4 h-4 md:w-6 md:h-6 flex justify-center items-center q-answered-marked shrink-0 text-[8px] md:text-xs"></div> <span>Ans & Marked ({stats.answered_marked})</span></div>
                                </div>
                            </div>
                            
                            {/* Palette Grid */}
                            <div className="flex-1 overflow-y-auto p-3 md:p-4 bg-[#eef2f5]">
                                <div className="text-xs md:text-sm font-bold text-gray-700 mb-2 md:mb-3 border-b border-gray-300 pb-1">Question Palette:</div>
                                <div className="grid grid-cols-7 sm:grid-cols-6 md:grid-cols-5 gap-1.5 md:gap-3">
                                    {QUIZ_DATA.map((_, i) => {
                                        let btnClass = "w-7 h-7 md:w-10 md:h-10 flex justify-center items-center font-bold text-[10px] md:text-sm shadow-sm cursor-pointer hover:opacity-80 transition ";
                                        const stat = statuses[i];
                                        
                                        if (stat === 'answered') btnClass += "q-answered";
                                        else if (stat === 'not_answered') btnClass += "q-not-answered";
                                        else if (stat === 'marked') btnClass += "q-marked";
                                        else if (stat === 'answered_marked') btnClass += "q-answered-marked";
                                        else btnClass += "q-not-visited";
                                        
                                        // Highlight current active question
                                        if (i === currentQIndex) {
                                            btnClass += " ring-2 md:ring-4 ring-blue-400 ring-offset-1 md:ring-offset-1";
                                        }

                                        return (
                                            <div 
                                                key={i} 
                                                onClick={() => navigateToQuestion(i)}
                                                className={btnClass}
                                                title={`Question ${i+1}`}
                                            >
                                                {i + 1}
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                            
                            {/* Submit Button */}
                            <div className="p-3 md:p-4 bg-white md:bg-gray-100 border-t border-gray-300 shrink-0 pb-6 md:pb-4">
                                <button 
                                    onClick={() => { setShowMobilePalette(false); setShowSubmitModal(true); }}
                                    className="w-full py-2.5 md:py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded shadow-md transition text-sm md:text-base active:bg-blue-800"
                                >
                                    Submit Test
                                </button>
                            </div>
                        </div>
                    </div>

                    {/* Submit Confirmation Modal */}
                    {showSubmitModal && (
                        <div className="fixed inset-0 bg-black/60 z-[60] flex items-center justify-center backdrop-blur-sm p-4">
                            <div className="bg-white p-5 md:p-6 rounded-xl shadow-2xl max-w-sm md:max-w-md w-full border border-gray-200">
                                <h3 className="text-lg md:text-xl font-bold text-gray-800 mb-3 md:mb-4 flex items-center"><i data-lucide="alert-circle" className="text-blue-500 mr-2 w-5 h-5 md:w-6 md:h-6"></i> Submit Assessment</h3>
                                <p className="text-sm md:text-base text-gray-600 mb-5 md:mb-6">Are you sure you want to submit the test? You will not be able to modify your answers after submission.</p>
                                
                                <div className="flex flex-col sm:flex-row gap-3 md:gap-4">
                                    <button 
                                        onClick={() => setShowSubmitModal(false)}
                                        className="flex-1 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold rounded transition text-sm md:text-base w-full"
                                    >
                                        Cancel
                                    </button>
                                    <button 
                                        onClick={handleSubmitTest}
                                        className="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded transition shadow text-sm md:text-base w-full"
                                    >
                                        Confirm Submit
                                    </button>
                                </div>
                            </div>
                        </div>
                    )}
                </div>
            );
        };

        ReactDOM.render(<CBTApp />, document.getElementById('root'));
        
        setTimeout(() => {
            lucide.createIcons();
        }, 100);
    </script>
</body>
</html>
